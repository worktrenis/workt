{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "otaMessage",
			"type": "promptString",
			"description": "Messaggio OTA (apparirà in EAS Update)",
			"default": "Fix reperibilità festivi + riepilogo + dashboard"
		}
	],
	"tasks": [
		{
			"label": "Start Expo Development Server",
			"type": "shell",
			"command": "npx expo start",
			"group": "build",
			"isBackground": true,
			"problemMatcher": [],
			"args": []
		},
		{
			"label": "OTA: Publish (production)",
			"type": "shell",
			"command": "npx eas update",
			"args": [
				"--channel",
				"production",
				"--message",
				"${input:otaMessage}"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "OTA: Release Script (production, skip git)",
			"type": "shell",
			"command": "npm run ota:release -- --skip-git",
			"args": [
				"--message",
				"${input:otaMessage}"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "OTA: Auto (bump patch, skip git)",
			"type": "shell",
			"command": "npm run ota:auto -- --skip-git",
			"args": [
				"--message",
				"${input:otaMessage}"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Diagnostics: Node Resolution",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"& '${workspaceFolder}\\scripts\\windows-node-doctor.ps1'"
			],
			"problemMatcher": []
		}
	]
}